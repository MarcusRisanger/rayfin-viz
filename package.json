{
  "name": "better-visuals",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "template": {
    "name": "universal-app",
    "displayName": "Universal App",
    "description": "A lean React + Vite starter that grows into anything. A built-in capability router reads what you ask for, then enables the right Rayfin services, installs the right modules, and activates the right skills, from sign-in and CRUD data models to Graphein charts and Fabric analytics dashboards."
  },
  "scripts": {
    "predev": "rayfin env --framework vite",
    "prebuild": "rayfin env --framework vite",
    "dev": "rayfin up --exclude-services staticHosting && vite",
    "preview": "vite",
    "build": "tsc -b && vite build",
    "build:fabric": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "rayfin:up": "rayfin up",
    "pack:add": "node scripts/scaffold.mjs"
  },
  "dependencies": {
    "@fontsource/lato": "^5.3.0",
    "@microsoft/fabric-app-data": "^1.1.0",
    "@microsoft/rayfin-auth-provider-fabric": "^1.36.2",
    "@microsoft/rayfin-client": "^1.36.2",
    "@microsoft/rayfin-core": "^1.34.0",
    "@tailwindcss/vite": "^4.3.3",
    "graphein": "^0.21.0",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@microsoft/rayfin-cli": "^1.36.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^16.5.0",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "tar": "7.5.22",
    "@azure/msal-node": {
      "uuid": "11.1.1"
    },
    "@opentelemetry/otlp-transformer": {
      "protobufjs": "8.8.0"
    },
    "@opentelemetry/core": "2.11.0",
    "@opentelemetry/propagator-jaeger": "2.11.0"
  }
}
